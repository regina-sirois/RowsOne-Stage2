#!/usr/bin/env bash
# Pre-commit hook: ruff format + lint check, then unit tests.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

export PATH="${HOME}/.local/bin:${PATH}"

run_module() {
  # Always invoke as `python -m <module>` so `uv run` spawns python, not the module name.
  if command -v uv >/dev/null 2>&1; then
    uv run python -m "$@"
  elif [[ -x "${REPO_ROOT}/.venv/bin/python" ]]; then
    "${REPO_ROOT}/.venv/bin/python" -m "$@"
  else
    python3 -m "$@"
  fi
}

run_ruff() {
  if command -v uv >/dev/null 2>&1; then
    uv run ruff "$@"
  elif [[ -x "${REPO_ROOT}/.venv/bin/ruff" ]]; then
    "${REPO_ROOT}/.venv/bin/ruff" "$@"
  else
    ruff "$@"
  fi
}

STAGED_PY_FILES=()
while IFS= read -r file; do
  STAGED_PY_FILES+=("$file")
done < <(
  git diff --cached --name-only --diff-filter=ACM \
    | grep -E '\.py$' \
    | grep -vE '(^|/)generated/' \
    || true
)

if [[ ${#STAGED_PY_FILES[@]} -gt 0 ]]; then
  echo "pre-commit: checking ruff format on staged Python files..."
  echo
  run_ruff format --check "${STAGED_PY_FILES[@]}"
  echo
  echo "pre-commit: ruff format check passed."
  echo

  echo "pre-commit: running ruff check on staged Python files..."
  echo
  run_ruff check "${STAGED_PY_FILES[@]}"
  echo
  echo "pre-commit: ruff check passed."
  echo
fi

echo "pre-commit: running unit tests (framework/unittest/)..."
echo

run_module pytest framework/unittest/ -q

echo
echo "pre-commit: tests passed."
